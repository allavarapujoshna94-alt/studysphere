# MongoDB connection string.
# Local MongoDB:   mongodb://127.0.0.1:27017/sharemynotes
# MongoDB Atlas:   mongodb+srv://<username>:<password>@<cluster-url>/sharemynotes?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/sharemynotes

# Any long random string works. Used to sign login tokens.
JWT_SECRET=change_this_to_a_long_random_secret

# Port the backend server runs on
PORT=5000
